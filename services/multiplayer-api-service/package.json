{
  "name": "@multiplayer/api",
  "version": "0.0.1",
  "description": "",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsc -w & nodemon --watch dist ./dist/index.js",
    "build": "npm run clean && npm run compile && cp -R ./src/lib/notification/email-templates/templates ./dist/lib/notification/email-templates/templates",
    "clean": "rm -rf ./dist",
    "compile": "tsc --build --force",
    "build:docker": "cd ../../ && bash ./scripts/docker-build.sh",
    "push:docker": "bash ../../scripts/docker-push.sh",
    "build:push:docker": "npm run build:docker && npm run push:docker",
    "octopus:release": "bash ../../scripts/octopus-release.sh",
    "multiplayer:release": "bash ../../scripts/multiplayer-release.sh",
    "lint": "eslint src/**/*.ts --config ../../eslint.config.js",
    "test": "env-cmd -f .env.test jest --forceExit",
    "test:local": "env-cmd -f .env.test-local jest --forceExit",
    "script:vectorize-entities": "node dist/scripts/vectorize-entities.js"
  },
  "author": "Multiplayer",
