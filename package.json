{
  "name": "@multiplayer/monorepo",
  "version": "1.0.1-alpha.0",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:pm2": "bash ./scripts/start-pm2.sh",
    "stop:pm2": "bash ./scripts/stop-pm2.sh",
    "mongo-restore": "bash ./scripts/import-db-docker.sh",
    "mongo-export": "bash ./scripts/export-db-docker.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prepare": "npx husky install",
    "create-invite-token": "tsc -p scripts/seed/create-invitation-token && node scripts/seed/create-invitation-token/dist/create-invitation-token.js",
    "seed-roles": "npm --prefix scripts/seed/seed-roles start",
    "migrate:up": "cd ./migrations && npm install && npx migrate-mongo up",
    "migrate:down": "cd ./migrations && npm install && npx migrate-mongo down",
    "migrate:create": "cd ./migrations && npm install && npx migrate-mongo create"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiplayer-app/multiplayer-platform.git"
  },
  "author": "Multiplayer",
  "bugs": {
    "url": "https://github.com/multiplayer-app/multiplayer-platform/issues"
  },
  "homepage": "https://github.com/multiplayer-app/multiplayer-platform#readme",
  "dependencies": {
    "lerna": "7.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "17.4.4",
    "@commitlint/config-conventional": "17.4.4",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "10.1.0",
    "husky": "9.1.5",
    "lint-staged": "13.1.2",
    "turbo": "^2.8.20",
    "typescript": "6.0.2"
  },
  "resolutions": {
    "zod": "3.25.55"
  },
  "pnpm": {
    "overrides": {
      "@multiplayer/multiplayer-web-app>eslint": "^8.57.0",
      "@multiplayer-app/session-recorder-common@2.0.85>@opentelemetry/core": "2.6.1",
      "@multiplayer-app/session-recorder-common@2.0.85>@opentelemetry/resources": "2.6.1",
      "@multiplayer-app/session-recorder-common@2.0.85>@opentelemetry/sdk-trace-base": "2.6.1",
      "@opentelemetry/instrumentation-user-interaction@0.48.1>@opentelemetry/core": "2.6.1",
      "@multiplayer-app/session-recorder-common@2.0.85>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/core@2.0.1>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/core@2.6.1>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/resources@2.0.1>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/sdk-trace-base@2.0.1>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/instrumentation-fetch@0.203.0>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/instrumentation-xml-http-request@0.203.0>@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/api-logs@0.203.0>@opentelemetry/api": "1.9.1"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "mongodb-client-encryption"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
