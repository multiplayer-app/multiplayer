{
    "name": "@multiplayer/mongo",
    "version": "0.0.1",
    "description": "Multiplayer mongodb library",
    "main": "dist/index.js",
    "engines": {
        "node": ">=18",
        "npm": ">=8"
    },
    "scripts": {
        "lint": "eslint src/**/*.ts --config ../../eslint.config.js",
        "preversion": "npm run lint",
        "postversion": "git push && git push --tags",
        "build": "tsc --build --force"
    },
    "author": "Multiplayer",
    "keywords": [
        "mongo",
        "mongoose",
        "library"
    ],
    "dependencies": {
        "@aws-sdk/credential-providers": "3.1152.0",
        "@multiplayer/logger": "0.0.1",
        "mongodb": "7.7.0",
        "mongodb-client-encryption": "7.2.1",
        "mongodb-connection-string-url": "7.0.2",
        "mongoose": "9.11.2"
    },
    "devDependencies": {
        "@types/node": "25.5.0",
        "eslint": "10.1.0",
        "typescript": "7.0.2"
    }
}
