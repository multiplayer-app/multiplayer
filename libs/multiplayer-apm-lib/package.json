{
  "name": "@multiplayer/apm",
  "description": "Multiplayer apm",
  "version": "0.0.1",
  "author": "Multiplayer",
  "main": "dist/index.js",
  "contributors": [
    "Dmytro Shvaika <shvajka@gmail.com>"
  ],
  "dependencies": {
    "@multiplayer-app/session-recorder-node": "2.0.89",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-prometheus": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "protobufjs": "8.8.1",
    "to-json-schema": "0.2.5",
    "openapi-json-schema": "2.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@opentelemetry/auto-instrumentations-node": {
      "@opentelemetry/api": "1.10.0",
      "@opentelemetry/instrumentation-express": "$@opentelemetry/instrumentation-express"
    }
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "keywords": [
    "apm",
    "library"
  ],
  "scripts": {
    "lint": "eslint src/**/*.ts --config ../../eslint.config.js",
    "preversion": "npm run lint",
    "postversion": "git push && git push --tags",
    "build": "tsc --build --force"
  }
}
